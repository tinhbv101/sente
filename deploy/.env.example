# Copy to .env and fill in. Never commit .env.

# The public host name. TLS is terminated by your reverse proxy; the server only
# uses this to build invitation links and to check WebSocket origins.
SENTE_DOMAIN=sente.example.com

# Where the server is published for the reverse proxy on this host. Loopback by
# default, so nothing reaches it without going through the proxy. Change the port
# if 8080 is already taken; never change the bind address to 0.0.0.0.
SENTE_BIND=127.0.0.1
SENTE_PORT=8080

# Only if the domain is proxied through a CDN (Cloudflare's orange cloud). Without
# this every user behind the CDN shares one rate-limit bucket. Leave empty when
# the proxy on this host is the first hop.
SENTE_CLIENT_IP_HEADER=CF-Connecting-IP

# Generate both of these, do not invent them by hand:
#   openssl rand -hex 32
SENTE_JWT_SECRET=
POSTGRES_PASSWORD=

# Set to the release tag when deploying something other than the working tree.
SENTE_VERSION=dev

# ── Apple ─────────────────────────────────────────────────────────────────────
# Team ID (Membership details). Enables universal links and the AASA file.
SENTE_APPLE_TEAM_ID=
# Bundle id the identity tokens and pushes are for.
SENTE_APPLE_BUNDLE_ID=app.sente.go

# Directory holding the .p8 keys, mounted read-only at /run/secrets. Git-ignored.
# chmod 711 on the directory, 644 on the files: the container is non-root.
SENTE_SECRETS_DIR=./secrets

# APNs auth key (Certificates, Identifiers & Profiles → Keys). Drop the download,
# AuthKey_<KEY_ID>.p8, into the secrets directory as is. Empty disables push.
SENTE_APNS_KEY_ID=

# Sign in with Apple key, same place. Verifying sign-ins needs no key; this one
# is for Apple's token endpoint (code validation, revocation notices).
SENTE_SIWA_KEY_ID=

# Only when a key file is not named AuthKey_<KEY_ID>.p8:
# SENTE_APNS_KEY_FILE=/run/secrets/apns.p8
# SENTE_SIWA_KEY_FILE=/run/secrets/siwa.p8
