# Copy to .env and fill in. Never commit .env.

# The public host name. TLS is terminated by your reverse proxy; the server only
# uses this to build invitation links and to check WebSocket origins.
SENTE_DOMAIN=sente.example.com

# The Docker network your reverse proxy lives on, so it can reach `sente:8080`
# by name. Find it with:
#   docker inspect <proxy-container> --format '{{range $k,$_ := .NetworkSettings.Networks}}{{$k}} {{end}}'
PROXY_NETWORK=nginx-proxy-manager_default

# Generate both of these, do not invent them by hand:
#   openssl rand -hex 32
SENTE_JWT_SECRET=
POSTGRES_PASSWORD=

# Set to the release tag when deploying something other than the working tree.
SENTE_VERSION=dev
