# Copy to .env and fill in. Never commit .env.

# The domain pointing at this VPS. Caddy gets a certificate for it automatically,
# so the DNS A record must already resolve here before the first start.
SENTE_DOMAIN=sente.example.com

# Generate both of these, do not invent them by hand:
#   openssl rand -hex 32
SENTE_JWT_SECRET=
POSTGRES_PASSWORD=

# Set to the release tag when deploying something other than the working tree.
SENTE_VERSION=dev

# Derived from SENTE_DOMAIN by docker-compose.prod.yml; only override when the
# public address differs from the TLS host (a CDN in front, say).
# SENTE_PUBLIC_URL=https://sente.example.com
