# Caddy terminates TLS and gets its certificate from Let's Encrypt on its own.
# Nothing about certificates needs configuring beyond the domain name.

{$SENTE_DOMAIN} {
	encode zstd gzip

	# WebSocket connections are long-lived by design, so they must not be cut off
	# by a proxy read timeout the way an ordinary request would be.
	reverse_proxy sente:8080 {
		flush_interval -1
		health_uri /healthz
		health_interval 10s
	}

	log {
		output stdout
		format json
	}
}
